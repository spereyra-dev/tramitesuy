# TrámitesUY production deployment variables (task 40/41, S13, design §8).
#
# This file is a TEMPLATE. The operator copies it to a managed location
# OUTSIDE this repository (e.g. /etc/tramitesuy/.env), fills in the real
# values, and runs:
#
#   docker compose --env-file /etc/tramitesuy/.env --profile prod up -d
#
# No committed file may ever contain a real credential value; `make
# check-deploy` asserts this and that compose refuses to start without the
# required variables (empty defaults — the postgres image refuses to start
# without a real password, the documented fail-safe).
#
# The development stack does not read this file: `docker compose up -d db`
# (dev profile) keeps its committed local development credential.

# Database credentials (required — the stack refuses to serve without them).
POSTGRES_USER=tramitesuy
POSTGRES_PASSWORD=change-me-strong-operator-managed
POSTGRES_DB=tramitesuy

# Data directory on the host: put it on the SSD (design §8 — PostgreSQL and
# the durable generations live on SSD, not the SD card).
DB_DATA_DIR=/srv/tramitesuy/db

# ARM64 release image built off-device with `make image-arm64` (task 40).
TRAMITESUY_IMAGE=tramitesuy/api:arm64

# TLS material for the proxy (task 41): operator-managed host directory
# holding tls.crt/tls.key, mounted read-only into the proxy container.
PROXY_TLS_DIR=/etc/tramitesuy/tls

# Optional ingestion overrides (defaults match the code; task 43 rehearses
# resetting these to their prior defaults).
INGEST_TZ=America/Montevideo
INGEST_AT=06:00
