  "query": "SELECT DISTINCT ON (g.slug) g.slug, g.name, g.status, g.category_slug,\n                  COALESCE(l.description, '') AS \"description!\"\n           FROM generation_life_events g\n           LEFT JOIN life_events l ON l.slug = g.slug\n           WHERE g.generation_id = $1\n           ORDER BY g.slug",
