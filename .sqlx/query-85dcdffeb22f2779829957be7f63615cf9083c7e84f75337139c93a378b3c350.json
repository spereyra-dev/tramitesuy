  "query": "SELECT p.external_id, p.name, p.description, o.name AS \"organization_name: Option<String>\", p.official_url, p.status, p.raw_data, p.last_seen_at FROM procedures p LEFT JOIN organizations o ON o.id = p.organization_id WHERE p.external_id = $1 ORDER BY (p.status = 'active') DESC, p.created_at DESC LIMIT 1",
