  "db_name": "PostgreSQL",
  "query": "SELECT r.order_index, r.importance, r.required, p.external_id AS \"slug\", p.name, p.status, p.official_url, p.last_seen_at, o.short_name AS \"organization_short_name\", CASE WHEN jsonb_typeof(p.raw_data -> 'tiene_costo') = 'string' AND btrim(p.raw_data ->> 'tiene_costo') <> '' AND jsonb_typeof(p.raw_data -> 'valor') = 'string' AND btrim(p.raw_data ->> 'valor') <> '' THEN p.raw_data ->> 'valor' END AS \"cost\" FROM life_event_procedures r JOIN procedures p ON p.id = r.procedure_id JOIN life_events e ON e.id = r.life_event_id LEFT JOIN organizations o ON o.id = p.organization_id WHERE e.slug = $1 ORDER BY r.order_index, p.external_id",
